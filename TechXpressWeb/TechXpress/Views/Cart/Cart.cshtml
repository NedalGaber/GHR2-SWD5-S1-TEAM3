
@{
    ViewData["Title"] = "Your Cart - TechXpress";
   
}

<section class="py-5">
    <div class="container">
        <h1 class="mb-4">Your Shopping Cart</h1>

        <div class="row">
            <!-- Cart Items -->
            <div class="col-lg-8">
                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <!-- Cart Item 1 -->
                        <div class="row align-items-center mb-4 cart-item">
                            <div class="col-md-2">
                                <img src="https://via.placeholder.com/100" alt="Product" class="img-fluid">
                            </div>
                            <div class="col-md-5">
                                <h5 class="mb-1">Smartphone X</h5>
                                <p class="text-muted mb-1">Color: Black</p>
                                <p class="text-danger mb-0">In Stock</p>
                            </div>
                            <div class="col-md-3">
                                <div class="input-group">
                                    <button class="btn btn-outline-secondary quantity-btn">-</button>
                                    <input type="text" class="form-control text-center" value="1">
                                    <button class="btn btn-outline-secondary quantity-btn">+</button>
                                </div>
                            </div>
                            <div class="col-md-2 text-end">
                                <h5 class="mb-0">$799</h5>
                                <button class="btn btn-link text-danger p-0"><small>Remove</small></button>
                            </div>
                        </div>

                        <!-- Cart Item 2 -->
                        <div class="row align-items-center mb-4 cart-item">
                            <div class="col-md-2">
                                <img src="https://via.placeholder.com/100" alt="Product" class="img-fluid">
                            </div>
                            <div class="col-md-5">
                                <h5 class="mb-1">Wireless Headphones</h5>
                                <p class="text-muted mb-1">Color: White</p>
                                <p class="text-danger mb-0">In Stock</p>
                            </div>
                            <div class="col-md-3">
                                <div class="input-group">
                                    <button class="btn btn-outline-secondary quantity-btn">-</button>
                                    <input type="text" class="form-control text-center" value="1">
                                    <button class="btn btn-outline-secondary quantity-btn">+</button>
                                </div>
                            </div>
                            <div class="col-md-2 text-end">
                                <h5 class="mb-0">$249</h5>
                                <button class="btn btn-link text-danger p-0"><small>Remove</small></button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="d-flex justify-content-between">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark">
                        <i class="fas fa-arrow-left me-2"></i>Continue Shopping
                    </a>
                </div>

            </div>

            <!-- Order Summary -->
            <div class="col-lg-4">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title mb-3">Order Summary</h5>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal</span>
                            <span>$1,048.00</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Shipping</span>
                            <span>$0.00</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Tax</span>
                            <span>$83.84</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between mb-3">
                            <h5>Total</h5>
                            <h5>$1,131.84</h5>
                        </div>
                        <form asp-controller="Payment" asp-action="Pay" method="post">
                            <button type="submit" class="btn btn-primary w-100 py-2">
                                Proceed to Checkout
                            </button>
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Styles {
    <style>
        .cart-item {
            transition: all 0.3s;
        }

        .quantity-btn {
            width: 30px;
            height: 30px;
        }
    </style>
}

@section Scripts {
    <script src="~/js/script.js"></script>
}
