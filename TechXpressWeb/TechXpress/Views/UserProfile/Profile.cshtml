
@{
    ViewData["Title"] = "Profile";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Profile - TechXpress</title>

    <style>
        body {
            background-color: #f8f9fa;
            padding-top: 20px;
        }

        .profile-container {
            max-width: 1000px;
            margin: 0 auto;
            background-color: #fff;
            border-radius: 10px;
            box-shadow: 0 0 20px rgba(0,0,0,0.1);
            padding: 30px;
            margin-bottom: 30px;
        }

        .profile-img {
            width: 150px;
            height: 150px;
            object-fit: cover;
            border-radius: 50%;
            border: 5px solid #f8f9fa;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

        .profile-header {
            background-color: #f8f9fa;
            border-radius: 10px;
            padding: 30px;
            margin-bottom: 30px;
        }

        .edit-form-container {
            display: none;
        }

        .card {
            border: none;
            box-shadow: 0 0 10px rgba(0,0,0,0.05);
            margin-bottom: 20px;
        }

        .card-header {
            background-color: #f8f9fa;
            border-bottom: none;
            padding: 15px 20px;
        }

        .btn-primary {
            background-color: #0d6efd;
            border-color: #0d6efd;
        }

            .btn-primary:hover {
                background-color: #0b5ed7;
                border-color: #0a58ca;
            }
    </style>
</head>
<body>
    <div class="container profile-container">
        <h2 class="text-center mb-4">User Profile</h2>

        <div class="profile-header">
            <div class="row align-items-center">
                
                <div class="col-md-9">
                    <h3 id="profile-name">Admin User</h3>
                    <p class="text-muted" id="profile-role">Store Administrator</p>
                    <p><i class="fas fa-envelope me-2"></i><span id="profile-email">admin@techxpress.com</span></p>
                    <p><i class="fas fa-phone me-2"></i><span id="profile-phone">+1 (555) 123-4567</span></p>
                    <a asp-controller="UserProfile" asp-action="EditProfile" class="btn btn-primary" id="edit-profile-btn">
                        <i class="fas fa-edit me-2"></i>Edit Profile
                    </a>

                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Account Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-md-3 fw-bold">Full Name</div>
                            <div class="col-md-9" id="info-name">Admin User</div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-3 fw-bold">Email</div>
                            <div class="col-md-9" id="info-email">admin@techxpress.com</div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-3 fw-bold">Phone</div>
                            <div class="col-md-9" id="info-phone">+1 (555) 123-4567</div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-3 fw-bold">Role</div>
                            <div class="col-md-9" id="info-role">Store Administrator</div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-3 fw-bold">Join Date</div>
                            <div class="col-md-9" id="info-join-date">January 15, 2023</div>
                        </div>
                        <div class="row">
                            <div class="col-md-3 fw-bold">Last Login</div>
                            <div class="col-md-9" id="info-last-login">May 13, 2025 - 10:46 AM</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-12">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Security</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <h6 class="mb-0">Password</h6>
                                <p class="text-muted mb-0">Last changed: April 10, 2025</p>
                            </div>
                            <button class="btn btn-outline-primary" id="change-password-btn" data-bs-toggle="modal" data-bs-target="#passwordModal">Change Password</button>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-0">Two-Factor Authentication</h6>
                                <p class="text-muted mb-0">Current status: <span class="text-danger">Disabled</span></p>
                            </div>
                            <button class="btn btn-outline-success" id="enable-2fa-btn">Enable</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Recent Activity</h5>
                    </div>
                    <div class="card-body">
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="mb-0">Logged in</h6>
                                    <p class="text-muted mb-0">May 13, 2025 - 10:46 AM</p>
                                </div>
                                <span class="badge bg-primary rounded-pill"><i class="fas fa-sign-in-alt"></i></span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="mb-0">Updated product: iPhone 13 Pro</h6>
                                    <p class="text-muted mb-0">May 12, 2025 - 3:45 PM</p>
                                </div>
                                <span class="badge bg-success rounded-pill"><i class="fas fa-edit"></i></span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="mb-0">Added new product: AirPods Max</h6>
                                    <p class="text-muted mb-0">May 11, 2025 - 11:20 AM</p>
                                </div>
                                <span class="badge bg-success rounded-pill"><i class="fas fa-plus"></i></span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="mb-0">Changed password</h6>
                                    <p class="text-muted mb-0">April 10, 2025 - 09:15 AM</p>
                                </div>
                                <span class="badge bg-warning rounded-pill"><i class="fas fa-key"></i></span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

       </div>

    <div class="modal fade" id="passwordModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Change Password</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="password-form">
                        <div class="mb-3">
                            <label for="current-password" class="form-label">Current Password</label>
                            <input type="password" class="form-control" id="current-password">
                        </div>
                        <div class="mb-3">
                            <label for="new-password" class="form-label">New Password</label>
                            <input type="password" class="form-control" id="new-password">
                        </div>
                        <div class="mb-3">
                            <label for="confirm-password" class="form-label">Confirm New Password</label>
                            <input type="password" class="form-control" id="confirm-password">
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="save-password">Save Changes</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

