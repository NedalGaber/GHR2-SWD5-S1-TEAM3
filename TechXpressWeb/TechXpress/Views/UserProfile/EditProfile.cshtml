
@{
    ViewData["Title"] = "EditProfile";
}

<div id="edit-form-container" class="edit-form-container mt-4">
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Edit Profile</h5>
            <button type="button" class="btn-close" id="cancel-edit"></button>
        </div>
        <div class="card-body">
            <form id="profile-form">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label for="name" class="form-label">Full Name</label>
                        <input type="text" class="form-control" id="name" value="Admin User">
                    </div>
                    <div class="col-md-6">
                        <label for="role" class="form-label">Role</label>
                        <input type="text" class="form-control" id="role" value="Store Administrator" readonly>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label for="email" class="form-label">Email</label>
                        <input type="email" class="form-control" id="email" value="admin@techxpress.com">
                    </div>
                    <div class="col-md-6">
                        <label for="phone" class="form-label">Phone</label>
                        <input type="tel" class="form-control" id="phone" value="+1 (555) 123-4567">
                    </div>
                </div>
                <div class="mb-3">
                    <label for="profile-image" class="form-label">Profile Image</label>
                    <input type="file" class="form-control" id="profile-image">
                </div>
                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                    <button type="button" class="btn btn-secondary" id="cancel-profile">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="save-profile">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>
    </div>

