@model Product
@{
    ViewData["Title"] = "ProductDetails";
}

<!DOCTYPE html>
<html lang="en">
<head>

    <style>
        .product-gallery img {
            cursor: pointer;
            transition: all 0.3s;
        }

            .product-gallery img:hover {
                opacity: 0.8;
            }

        .thumbnail {
            border: 2px solid transparent;
            cursor: pointer;
        }

            .thumbnail.active, .thumbnail:hover {
                border-color: #0d6efd;
            }

        .specs-list dt {
            width: 150px;
            font-weight: 600;
        }

        .rating {
            color: #ffc107;
        }

        .qty-input {
            width: 70px;
        }
    </style>
</head>
<body>



    <!-- Product Detail Section -->
    <section class="py-4">
        <div class="container">
            <div class="row g-4">
                <!-- Product Gallery -->
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-body">
                            <div class="main-image mb-3">
                                <img src="@Url.Content($"~/{Model.Image}")" class="img-fluid" id="mainImage" alt="Product Image">
                            </div>
                           
                        </div>
                    </div>
                </div>

                <!-- Product Info -->
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-body">
                            <h2 class="card-title mb-2">@Model.ProductName</h2>
                            <div class="mb-2">
                                <span class="rating">
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star-half-alt"></i>
                                </span>
                                <span class="text-muted ms-1">(28 reviews)</span>
                            </div>
                            <div class="mb-3">
                                <span class="badge bg-success">In Stock</span>
                                <span class="badge bg-secondary">Free Shipping</span>
                            </div>
                            <h3 class="mb-3">@Model.Price$</h3>
                            <p class="mb-4">@Model.Description</p>

                   

                            <div class="d-flex align-items-center mb-4">
                                <div class="me-3">
                                    <label class="form-label">Quantity</label>
                                    <input type="number" class="form-control qty-input" value="1" min="1">
                                </div>
                                <div>
                                    <button class="btn btn-primary btn-lg">
                                        <i class="fas fa-shopping-cart me-2"></i>Add to Cart
                                    </button>
                                </div>
                            </div>

                           
                        </div>
                    </div>
                </div>
            </div>

            <!-- Product Tabs -->
            <div class="row mt-4">
                <div class="col-12">
                    <ul class="nav nav-tabs" id="productTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="description-tab" data-bs-toggle="tab" data-bs-target="#description" type="button">Description</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="specs-tab" data-bs-toggle="tab" data-bs-target="#specs" type="button">Specifications</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="reviews-tab" data-bs-toggle="tab" data-bs-target="#reviews" type="button">Reviews</button>
                        </li>
                    </ul>
                    <div class="tab-content p-4 border border-top-0 rounded-bottom" id="productTabsContent">
                        <div class="tab-pane fade show active" id="description" role="tabpanel">
                            <h4>Product Description</h4>
                            <p>@Model.Description</p>
                            
                        </div>
                        <div class="tab-pane fade" id="specs" role="tabpanel">
                            <h4>Technical Specifications</h4>
                            <div class="row">
                                <div class="col-md-6">
                                    <dl class="row specs-list">
                                        <dt class="col-sm-4">Display</dt>
                                        <dd class="col-sm-8">6.7-inch Super Retina XDR display with ProMotion</dd>

                                        <dt class="col-sm-4">Chip</dt>
                                        <dd class="col-sm-8">A15 Bionic chip with 5-core GPU</dd>

                                        <dt class="col-sm-4">Camera</dt>
                                        <dd class="col-sm-8">Pro camera system: Telephoto, Wide, and Ultra Wide cameras</dd>

                                        <dt class="col-sm-4">Front Camera</dt>
                                        <dd class="col-sm-8">12MP TrueDepth front camera</dd>
                                    </dl>
                                </div>
                                <div class="col-md-6">
                                    <dl class="row specs-list">
                                        <dt class="col-sm-4">Battery</dt>
                                        <dd class="col-sm-8">Up to 28 hours video playback</dd>

                                        <dt class="col-sm-4">Dimensions</dt>
                                        <dd class="col-sm-8">160.8 x 78.1 x 7.65 mm</dd>

                                        <dt class="col-sm-4">Weight</dt>
                                        <dd class="col-sm-8">238 grams</dd>

                                        <dt class="col-sm-4">OS</dt>
                                        <dd class="col-sm-8">Latest OS with personalized features</dd>
                                    </dl>
                                </div>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="reviews" role="tabpanel">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <h4 class="mb-0">Customer Reviews</h4>
                                <button class="btn btn-primary">Write a Review</button>
                            </div>

                            <!-- Review Summary -->
                            <div class="row mb-4">
                                <div class="col-md-4">
                                    <div class="text-center">
                                        <!-- Dynamic rating based on model -->
                                        <h2 class="mb-0">@Model.Rating</h2>
                                        <div class="rating mb-2">
                                            @for (int i = 0; i < (int)Model.Rating; i++)
                                            {
                                                <i class="fas fa-star"></i>
                                            }
                                            @if (Model.Rating % 1 != 0)
                                            {
                                                <i class="fas fa-star-half-alt"></i>
                                            }
                                            @for (int i = (int)Model.Rating; i < 5; i++)
                                            {
                                                <i class="far fa-star"></i>
                                            }
                                        </div>
                                        <p class="text-muted">Based on 28 review</p>
                                    </div>
                                </div>
                       
                            </div>


                            <!-- Individual Reviews -->
                            <div class="mb-4 p-4 border rounded">
                                <div class="d-flex justify-content-between mb-2">
                                    <h5 class="mb-0">Amazing phone!</h5>
                                    <div class="rating">
                                        <i class="fas fa-star"></i>
                                        <i class="fas fa-star"></i>
                                        <i class="fas fa-star"></i>
                                        <i class="fas fa-star"></i>
                                        <i class="fas fa-star"></i>
                                    </div>
                                </div>
                                <p class="text-muted">By John D. on October 15, 2023</p>
                                <p>The camera system is truly professional quality. I've been able to take photos that rival my DSLR. The battery life is excellent too, lasting me almost two days with moderate use.</p>
                            </div>

                            <div class="mb-4 p-4 border rounded">
                                <div class="d-flex justify-content-between mb-2">
                                    <h5 class="mb-0">Great but heavy</h5>
                                    <div class="rating">
                                        <i class="fas fa-star"></i>
                                        <i class="fas fa-star"></i>
                                        <i class="fas fa-star"></i>
                                        <i class="fas fa-star"></i>
                                        <i class="far fa-star"></i>
                                    </div>
                                </div>
                                <p class="text-muted">By Sarah K. on October 10, 2023</p>
                                <p>Love the performance and display, but it's noticeably heavier than my previous phone. The ProMotion display is stunning though, and scrolling is incredibly smooth.</p>
                            </div>

                            <div class="mb-4 p-4 border rounded">
                                <div class="d-flex justify-content-between mb-2">
                                    <h5 class="mb-0">Worth every penny</h5>
                                    <div class="rating">
                                        <i class="fas fa-star"></i>
                                        <i class="fas fa-star"></i>
                                        <i class="fas fa-star"></i>
                                        <i class="fas fa-star"></i>
                                        <i class="fas fa-star-half-alt"></i>
                                    </div>
                                </div>
                                <p class="text-muted">By Michael T. on October 5, 2023</p>
                                <p>This is the best phone I've ever owned. The speed is incredible, and the camera system lets me leave my dedicated camera at home for most situations. The night mode photos are particularly impressive.</p>
                            </div>

                            <div class="d-grid">
                                <button class="btn btn-outline-primary">Load More Reviews</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


        </div>
    </section>



    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Change main product image when thumbnail is clicked
        function changeImage(element) {
            document.getElementById('mainImage').src = element.src;

            // Update active class on thumbnails
            let thumbnails = document.querySelectorAll('.thumbnail');
            thumbnails.forEach(thumb => {
                thumb.classList.remove('active');
            });
            element.classList.add('active');
        }
    </script>
</body>
</html>


