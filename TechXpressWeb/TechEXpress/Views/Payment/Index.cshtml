@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment | ShopDark</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootswatch@5/dist/lux/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background-color: white;
            padding-top: 20px;
        }

        .summary {
            background-color: #f8f9fa;
            padding: 20px;
            border-radius: 5px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }

            .summary h5 {
                font-size: 1.2rem;
                font-weight: bold;
            }

            .summary hr {
                margin-top: 10px;
                margin-bottom: 10px;
            }

        .payment-method img {
            width: 30px;
            margin-right: 10px;
        }

        .payment-btn {
            background-color: #ffc107;
            border-color: #ffc107;
            color: #212529;
        }

            .payment-btn:hover {
                background-color: #e0a800;
                border-color: #e0a800;
            }

        .form-control:focus {
            border-color: #ffc107;
            box-shadow: 0 0 0 0.25rem rgba(255, 193, 7, 0.25);
        }

        .order-summary {
            margin-top: 20px;
        }

            .order-summary .total-price {
                font-size: 1.4rem;
                font-weight: bold;
            }

        .card-details {
            border: 1px solid #dee2e6;
            padding: 15px;
            border-radius: 5px;
            margin-top: 20px;
        }

            .card-details label {
                font-weight: 500;
            }

        .payment-methods .method-btn {
            background-color: #e9ecef;
            border: none;
            padding: 15px;
            width: 100%;
            display: flex;
            align-items: center;
            margin-bottom: 10px;
            border-radius: 5px;
            cursor: pointer;
        }

            .payment-methods .method-btn:hover {
                background-color: #f1f1f1;
            }

            .payment-methods .method-btn .fa {
                font-size: 1.5rem;
                margin-right: 10px;
            }

            .payment-methods .method-btn.active {
                background-color: #ffc107;
            }

                .payment-methods .method-btn.active i {
                    color: #fff;
                }

        .btn-block {
            width: 100%;
        }
    </style>
</head>

<body>
    <div class="container py-5">
        <h2 class="text-center mb-5">Payment Information</h2>

        <div class="row">
            <!-- Payment Form -->
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Billing Details</h5>
                        <form>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="full-name" class="form-label">Full Name</label>
                                        <input type="text" class="form-control" id="full-name" required>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="email" class="form-label">Email Address</label>
                                        <input type="email" class="form-control" id="email" required>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="address" class="form-label">Shipping Address</label>
                                <input type="text" class="form-control" id="address" required>
                            </div>

                            <div class="mb-3">
                                <label for="phone" class="form-label">Phone Number</label>
                                <input type="tel" class="form-control" id="phone" required>
                            </div>

                            <h5 class="mt-4">Payment Method</h5>
                            <div class="payment-methods">
                                <div class="method-btn active" data-method="credit-card">
                                    <i class="fas fa-credit-card"></i>
                                    <span>Credit Card</span>
                                </div>
                                <div class="method-btn" data-method="paypal">
                                    <i class="fab fa-paypal"></i>
                                    <span>PayPal</span>
                                </div>
                                <div class="method-btn" data-method="bank-transfer">
                                    <i class="fas fa-university"></i>
                                    <span>Bank Transfer</span>
                                </div>
                            </div>

                            <!-- Credit Card Details -->
                            <div class="card-details" id="credit-card-details">
                                <div class="mb-3">
                                    <label for="card-number" class="form-label">Card Number</label>
                                    <input type="text" class="form-control" id="card-number" placeholder="1234 5678 9012 3456" required>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label for="expiry-date" class="form-label">Expiry Date</label>
                                            <input type="month" class="form-control" id="expiry-date" required>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label for="cvv" class="form-label">CVV</label>
                                            <input type="text" class="form-control" id="cvv" required>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- PayPal Details -->
                            <div class="card-details" id="paypal-details" style="display: none;">
                                <p>Proceed to PayPal to complete the payment.</p>
                            </div>

                            <!-- Bank Transfer Details -->
                            <div class="card-details" id="bank-transfer-details" style="display: none;">
                                <p>Transfer the total amount to the following bank account details:</p>
                                <pre>
                                        Account Name: ShopDark Ltd
                                        Bank: ABC Bank
                                        Account Number: 123-456-789
                                        Routing Number: 987654321
                                </pre>
                            </div>

                            <a href="track-order.html">
                                <button type="submit" class="btn btn-warning btn-block mt-4">
                                    Confirm and Pay
                                </button>
                            </a>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Order Summary -->
            <div class="col-lg-4">
                <div class="summary">
                    <h5>Order Summary</h5>
                    <hr>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Subtotal (3 items)</span>
                        <span id="subtotal">$299.97</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Shipping</span>
                        <span>$10.00</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Tax</span>
                        <span>$0.00</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between fw-bold fs-5">
                        <span>Total</span>
                        <span id="cart-total">$309.97</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Payment method selection
        const methods = document.querySelectorAll('.method-btn');
        methods.forEach((method) => {
            method.addEventListener('click', () => {
                methods.forEach((btn) => btn.classList.remove('active'));
                method.classList.add('active');

                // Show and hide payment details based on selected method
                const selectedMethod = method.getAttribute('data-method');
                document.querySelectorAll('.card-details').forEach((details) => {
                    details.style.display = 'none';
                });

                if (selectedMethod === 'credit-card') {
                    document.getElementById('credit-card-details').style.display = 'block';
                } else if (selectedMethod === 'paypal') {
                    document.getElementById('paypal-details').style.display = 'block';
                } else if (selectedMethod === 'bank-transfer') {
                    document.getElementById('bank-transfer-details').style.display = 'block';
                }
            });
        });
    </script>
</body>

</html>
