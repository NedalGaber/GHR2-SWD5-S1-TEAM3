    <script>
        // Quantity controls
        const qtyInput = document.querySelector('.input-group input');
        document.querySelectorAll('.input-group button').forEach(btn => {
          btn.addEventListener('click', () => {
            let currentQty = parseInt(qtyInput.value);
            if (btn.textContent === '+' && currentQty < 10) currentQty++;
            if (btn.textContent === '-' && currentQty > 1) currentQty--;
            qtyInput.value = currentQty;
          });
        });

        // Add to cart using localStorage
        document.querySelectorAll('.btn-primary, .sticky-cart .btn-success').forEach(btn => {
          btn.addEventListener('click', () => {
            const product = {
              id: 1,
              name: "Premium Wireless Headphones",
              price: 199.99,
              qty: parseInt(qtyInput.value)
            };
            const cart = JSON.parse(localStorage.getItem('cart')) || [];
            cart.push(product);
            localStorage.setItem('cart', JSON.stringify(cart));
            alert("Product added to cart!");
          });
        });

        // Load reviews from JSON
        const reviews = [
          { name: "Sarah L.", title: "Worth every cent", rating: 5, comment: "Incredible clarity and battery life!" },
          { name: "Mark H.", title: "Good, not great", rating: 3, comment: "Great features but not comfy after long use." }
        ];
        const reviewContainer = document.querySelector("#reviews");
        reviews.forEach(r => {
          const stars = '<i class="fas fa-star text-warning"></i>'.repeat(r.rating) +
                        '<i class="far fa-star text-warning"></i>'.repeat(5 - r.rating);
          reviewContainer.innerHTML += `
            <div class="card mb-3">
              <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                  <div>${stars} <strong class="ms-2">${r.title}</strong></div>
                  <small class="text-muted">Just now</small>
                </div>
                <p class="mb-2">${r.comment}</p>
                <small class="text-muted">By ${r.name}</small>
              </div>
            </div>
          `;
        });
    </script>
