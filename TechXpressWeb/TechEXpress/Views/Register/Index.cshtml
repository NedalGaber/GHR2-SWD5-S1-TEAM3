@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register - TechXpress</title>
    <meta name="description" content="Create your TechXpress account to enjoy exclusive deals and manage your orders easily." />

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <!-- Custom CSS -->
    <link rel="stylesheet" href="style.css" />
    <link rel="stylesheet" href="homepage.css" />
    <link rel="stylesheet" href="login_regs.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom">
            <div class="container-fluid">
                <a class="navbar-brand" href="index.html">
                    <img src="images/logo.png" alt="TechXpress Logo" height="40" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse justify-content-end" id="navbarNavAltMarkup">
                    <div class="navbar-nav align-items-center gap-3">
                        <a class="nav-link" href="homepage.html">Home</a>
                        <a class="nav-link" href="login.html">Login</a>
                        <a class="nav-link" href="faq.html">Help</a>
                        <a class="nav-link" href="contact.html">Contact</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <section class="signup sec_form mt-0 pt-0 d-flex align-items-center justify-content-center min-vh-100 bg-light">
        <div class="form_container bg-white shadow p-4 rounded-4 w-100" style="max-width: 600px;">
            <p class="title text-center fs-3 fw-bold mb-4">Create an Account</p>
            <form action="#" method="POST" class="form">
                <div class="mb-3">
                    <label for="first_name" class="form-label">First Name</label>
                    <input id="first_name" name="first_name" type="text" class="form-control" placeholder="Enter your first name" required />
                </div>

                <div class="mb-3">
                    <label for="last_name" class="form-label">Last Name</label>
                    <input id="last_name" name="last_name" type="text" class="form-control" placeholder="Enter your last name" required />
                </div>

                <div class="mb-3">
                    <label for="phone" class="form-label">Phone Number</label>
                    <input id="phone" name="phone" type="tel" class="form-control" placeholder="Enter your phone number" required />
                </div>

                <div class="mb-3">
                    <label for="email" class="form-label">Email</label>
                    <input id="email" name="email" type="email" class="form-control" placeholder="Enter your email" required />
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label">Password</label>
                    <input id="password" name="password" type="password" class="form-control" placeholder="Create a password" required />
                </div>

                <button class="form-btn btn btn-primary w-100" type="submit">Register</button>
            </form>

            <p class="sign-up-label text-center mt-3">
                Already have an account? <a href="login.html" class="sign-up-link">Login</a>
            </p>

            <div class="buttons-container d-flex flex-column gap-2 mt-3">
                <button type="button" class="apple-login-button btn btn-dark" aria-label="Register with Apple">
                    <i class="fab fa-apple me-2"></i> Sign up with Apple
                </button>

                <button type="button" class="google-login-button btn btn-outline-danger" aria-label="Register with Google">
                    <i class="fab fa-google me-2"></i> Sign up with Google
                </button>
            </div>
        </div>
    </section>

    <footer class="footer-section bg-light text-dark mt-5 pt-5 pb-3" role="contentinfo">
        <div class="container">
            <div class="row mb-5">
                <div class="col-md-6 mb-4 mb-md-0">
                    <h5 class="fw-bold mb-3">TechXpress<span class="text-primary">.</span></h5>
                    <p>Enhancing your home with comfort and design. Reach us for quality furniture and support.</p>
                    <div class="d-flex gap-3">
                        <a href="#" class="text-dark" aria-label="Facebook"><i class="fab fa-facebook-f fa-lg hover-opacity"></i></a>
                        <a href="#" class="text-dark" aria-label="Twitter"><i class="fab fa-twitter fa-lg hover-opacity"></i></a>
                        <a href="#" class="text-dark" aria-label="Instagram"><i class="fab fa-instagram fa-lg hover-opacity"></i></a>
                        <a href="#" class="text-dark" aria-label="LinkedIn"><i class="fab fa-linkedin-in fa-lg hover-opacity"></i></a>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="row">
                        <div class="col-6 col-md-4 mb-3">
                            <h6 class="fw-bold">Company</h6>
                            <ul class="list-unstyled">
                                <li><a href="#" class="text-decoration-none text-muted">About us</a></li>
                                <li><a href="#" class="text-decoration-none text-muted">Services</a></li>
                                <li><a href="#" class="text-decoration-none text-muted">Blog</a></li>
                                <li><a href="#" class="text-decoration-none text-muted">Contact</a></li>
                            </ul>
                        </div>
                        <div class="col-6 col-md-4 mb-3">
                            <h6 class="fw-bold">Support</h6>
                            <ul class="list-unstyled">
                                <li><a href="#" class="text-decoration-none text-muted">Help Center</a></li>
                                <li><a href="#" class="text-decoration-none text-muted">FAQs</a></li>
                                <li><a href="#" class="text-decoration-none text-muted">Live Chat</a></li>
                            </ul>
                        </div>
                        <div class="col-6 col-md-4 mb-3">
                            <h6 class="fw-bold">Products</h6>
                            <ul class="list-unstyled">
                                <li><a href="#" class="text-decoration-none text-muted">Nordic Chair</a></li>
                                <li><a href="#" class="text-decoration-none text-muted">Kruzo Aero</a></li>
                                <li><a href="#" class="text-decoration-none text-muted">Ergonomic Chair</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row mb-4">
                <div class="col-md-8 mx-auto text-center">
                    <h6 class="fw-bold mb-3">Subscribe to our newsletter</h6>
                    <form class="d-flex justify-content-center">
                        <input type="email" class="form-control w-50 me-2" placeholder="Enter your email" aria-label="Email address" />
                        <button type="submit" class="btn btn-primary">Subscribe</button>
                    </form>
                </div>
            </div>
            <div class="border-top pt-3 text-center small">
                <p class="mb-1">&copy; <script>document.write(new Date().getFullYear());</script> TechXpress. All rights reserved.</p>
                <p class="mb-0">
                    Designed by <a href="https://untree.co" target="_blank" rel="noopener">Untree.co</a>, Distributed by
                    <a href="https://themewagon.com" target="_blank" rel="noopener">ThemeWagon</a>
                </p>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="js/main.js"></script>
</body>
</html>
