@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cart | ShopDark</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootswatch@5/dist/lux/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background-color: white;
            padding-top: 20px;
        }

        .summary {
            background-color: #f8f9fa;
            padding: 20px;
            border-radius: 5px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            position: sticky;
            top: 20px;
        }

            .summary hr {
                margin-top: 10px;
                margin-bottom: 10px;
            }

            .summary h5 {
                font-size: 1.2rem;
                font-weight: bold;
            }

        .btn-warning {
            background-color: #ffc107;
            border-color: #ffc107;
            color: #212529;
        }

            .btn-warning:hover {
                background-color: #e0a800;
                border-color: #e0a800;
            }

        .table img {
            width: 120px;
            height: 120px;
            object-fit: cover;
            border-radius: 4px;
        }

        .table td,
        .table th {
            vertical-align: middle;
        }

        .table tbody tr:hover {
            background-color: rgba(0, 0, 0, 0.02);
        }

        .quantity {
            display: flex;
            align-items: center;
        }

        .quantity-btn {
            width: 30px;
            height: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #ffc107;
            border: none;
            color: white;
            cursor: pointer;
            border-radius: 4px;
            font-weight: bold;
        }

        .quantity-input {
            width: 50px;
            text-align: center;
            border: 1px solid #dee2e6;
            margin: 0 5px;
            padding: 5px;
            border-radius: 4px;
        }

        .remove-btn {
            background-color: transparent;
            border: none;
            color: #dc3545;
            cursor: pointer;
            transition: color 0.2s;
        }

            .remove-btn:hover {
                color: #b02a37;
            }

        .empty-cart {
            text-align: center;
            padding: 60px 0;
        }

        .empty-cart-icon {
            font-size: 5rem;
            color: #6c757d;
            margin-bottom: 20px;
        }

        .product-title {
            font-weight: 500;
            color: #212529;
        }

        .product-color {
            font-size: 0.9rem;
            color: #6c757d;
        }

   

        {
            display: none;
        }

        .table tr {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            padding: 15px;
            border: 1px solid #dee2e6;
            border-radius: 8px;
            margin-bottom: 15px;
        }

        .table td {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0;
            border: none;
        }

            .table td::before {
                content: attr(data-label);
                font-weight: bold;
                margin-right: 10px;
                color: #495057;
            }

            .table td[data-label="Product"] {
                grid-column: 1 / -1;
                justify-content: flex-start;
                gap: 15px;
            }

                .table td[data-label="Product"]::before {
                    display: none;
                }

            .table td[data-label="Remove"] {
                grid-column: 1 / -1;
                justify-content: center;
                padding-top: 10px;
                border-top: 1px solid #dee2e6;
            }

        }

       

        {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        .cart-item {
            animation: fadeIn 0.3s ease-out;
        }
    </style>
</head>

<body>
    <div class="container py-4">
        <div class="row">
            <div class="col-lg-8">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2 class="mb-0">Your Shopping Cart</h2>
                    <span class="badge bg-warning text-dark" id="item-count">3 items</span>
                </div>

                <div class="empty-cart d-none" id="empty-cart">
                    <div class="empty-cart-icon">
                        <i class="fas fa-shopping-cart"></i>
                    </div>
                    <h3 class="mb-3">Your cart is empty</h3>
                    <p class="text-muted mb-4">Looks like you haven't added anything to your cart yet</p>
                    <a href="index.html" class="btn btn-warning px-4">
                        <i class="fas fa-arrow-left me-2"></i>Continue Shopping
                    </a>
                </div>

                <div class="table-responsive" id="cart-items">
                    <table class="table">
                        <thead class="table-light">
                            <tr>
                                <th>Product</th>
                                <th>Details</th>
                                <th>Quantity</th>
                                <th>Price</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Cart Item 1 -->
                            <tr class="cart-item">
                                <td data-label="Product">
                                    <img src="images_/8.jpg" class="img-fluid" alt="Smartphone Stand" loading="lazy">
                                </td>
                                <td data-label="Details">
                                    <div class="product-title">Premium Wireless Headphones</div>
                                    <div class="product-color">Black</div>
                                </td>
                                <td data-label="Quantity">
                                    <div class="quantity">
                                        <button class="quantity-btn" aria-label="Decrease quantity">-</button>
                                        <input type="number" class="quantity-input" value="1" min="1" aria-label="Quantity">
                                        <button class="quantity-btn" aria-label="Increase quantity">+</button>
                                    </div>
                                </td>
                                <td data-label="Price" class="price" data-price="199.99">$199.99</td>
                                <td data-label="Action">
                                    <button class="remove-btn" aria-label="Remove item">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </td>
                            </tr>
                            <!-- Cart Item 2 -->
                            <tr class="cart-item">
                                <td data-label="Product">
                                    <img src="images_/8.jpg" class="img-fluid" alt="Smartphone Stand" loading="lazy">
                                </td>
                                <td data-label="Details">
                                    <div class="product-title">Portable Speaker</div>
                                    <div class="product-color">Blue</div>
                                </td>
                                <td data-label="Quantity">
                                    <div class="quantity">
                                        <button class="quantity-btn" aria-label="Decrease quantity">-</button>
                                        <input type="number" class="quantity-input" value="1" min="1" aria-label="Quantity">
                                        <button class="quantity-btn" aria-label="Increase quantity">+</button>
                                    </div>
                                </td>
                                <td data-label="Price" class="price" data-price="79.99">$79.99</td>
                                <td data-label="Action">
                                    <button class="remove-btn" aria-label="Remove item">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </td>
                            </tr>
                            <!-- Cart Item 3 -->
                            <tr class="cart-item">
                                <td data-label="Product">
                                    <img src="images_/8.jpg" class="img-fluid" alt="Smartphone Stand" loading="lazy">
                                </td>
                                <td data-label="Details">
                                    <div class="product-title">Smartphone Stand</div>
                                    <div class="product-color">Red</div>
                                </td>
                                <td data-label="Quantity">
                                    <div class="quantity">
                                        <button class="quantity-btn" aria-label="Decrease quantity">-</button>
                                        <input type="number" class="quantity-input" value="1" min="1" aria-label="Quantity">
                                        <button class="quantity-btn" aria-label="Increase quantity">+</button>
                                    </div>
                                </td>
                                <td data-label="Price" class="price" data-price="19.99">$19.99</td>
                                <td data-label="Action">
                                    <button class="remove-btn" aria-label="Remove item">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="d-flex justify-content-between mt-4">
                        <a href="homepage.html" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-2"></i>Continue Shopping
                        </a>
                        <button class="btn btn-outline-danger" id="clear-cart">
                            <i class="fas fa-trash-alt me-2"></i>Clear Cart
                        </button>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="summary">
                    <h5>Order Summary</h5>
                    <hr>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Subtotal (3 items)</span>
                        <span id="subtotal">$299.97</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Shipping</span>
                        <span>$10.00</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Tax</span>
                        <span>$0.00</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between fw-bold fs-5">
                        <span>Total</span>
                        <span id="cart-total">$309.97</span>
                    </div>
                    <button class="btn btn-warning w-100 mt-3 py-2 fw-bold">
                        Proceed to Checkout
                    </button>
                    <div class="mt-3 text-center">
                        <small class="text-muted">or</small>
                    </div>
                    <button class="btn btn-outline-dark w-100 mt-2">
                        <i class="fab fa-paypal me-2"></i>Checkout with PayPal
                    </button>
                </div>

                <div class="card mt-3">
                    <div class="card-body">
                        <h6 class="card-title">Have a promo code?</h6>
                        <div class="input-group mb-3">
                            <input type="text" class="form-control" placeholder="Enter code" aria-label="Promo code">
                            <button class="btn btn-outline-secondary" type="button">Apply</button>
                        </div>
                    </div>
                </div>

                <div class="mt-3 text-center">
                    <div class="mb-2">
                        <i class="fas fa-lock text-success me-2"></i>
                        <span>Secure Checkout</span>
                    </div>
                    <div class="d-flex justify-content-center gap-3">
                        <i class="fab fa-cc-visa fa-2x text-muted"></i>
                        <i class="fab fa-cc-mastercard fa-2x text-muted"></i>
                        <i class="fab fa-cc-amex fa-2x text-muted"></i>
                        <i class="fab fa-cc-discover fa-2x text-muted"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.quantity-btn').forEach(button => {
                button.addEventListener('click', function() {
                    const input = this.parentElement.querySelector('.quantity-input');
                    let quantity = parseInt(input.value);

                    if (this.textContent === '+') {
                        quantity += 1;
                    } else {
                        quantity = Math.max(1, quantity - 1);
                    }

                    input.value = quantity;
                    updateCart();
                });
            });

            document.querySelectorAll('.remove-btn').forEach(button => {
                button.addEventListener('click', function() {
                    this.closest('tr').remove();
                    updateCart();
                });
            });

            document.getElementById('clear-cart').addEventListener('click', function() {
                document.querySelectorAll('.cart-item').forEach(item => item.remove());
                updateCart();
            });

            function updateCart() {
                let subtotal = 0;
                let itemCount = 0;

                document.querySelectorAll('.cart-item').forEach(row => {
                    const price = parseFloat(row.querySelector('.price').dataset.price);
                    const quantity = parseInt(row.querySelector('.quantity-input').value);
                    const itemTotal = price * quantity;

                    row.querySelector('.price').textContent = '$' + itemTotal.toFixed(2);
                    subtotal += itemTotal;
                    itemCount += quantity;
                });

                document.getElementById('item-count').textContent = itemCount + ' items';
                document.getElementById('subtotal').textContent = '$' + subtotal.toFixed(2);
                document.getElementById('cart-total').textContent = '$' + (subtotal + 10).toFixed(2);

                if (itemCount === 0) {
                    document.getElementById('empty-cart').classList.remove('d-none');
                    document.getElementById('cart-items').classList.add('d-none');
                } else {
                    document.getElementById('empty-cart').classList.add('d-none');
                    document.getElementById('cart-items').classList.remove('d-none');
                }
            }

            updateCart();
        });
    </script>
</body>

</html>