<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact</title>
    <!-- External CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" type="text/css" href="style.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <style>
        .hero {
            background: #f8f9fa;
            padding: 5rem 0;
            text-align: center;
        }

        .contact-info i {
            font-size: 1.5rem;
            margin-right: 10px;
            color: #0d6efd;
        }

        .footer-section {
            background-color: #343a40;
            color: white;
            padding: 3rem 0;
        }

            .footer-section a {
                color: #adb5bd;
                text-decoration: none;
            }

                .footer-section a:hover {
                    color: white;
                }

        /* Advanced Button Styles */
        .btn-warning-custom {
            background-color: #ffcc00; /* Bright yellow */
            border-color: #ffcc00;
            color: #fff;
            font-weight: bold;
            text-transform: uppercase;
            padding: 0.5rem 2rem;
            border-radius: 30px;
            transition: all 0.3s ease-in-out;
        }

            .btn-warning-custom:hover {
                background-color: #ffb300; /* Darker yellow */
                border-color: #ffb300;
                transform: translateY(-3px);
            }

            .btn-warning-custom:active {
                background-color: #ff9900; /* Even darker yellow */
                border-color: #ff9900;
                transform: translateY(0);
            }
    </style>
</head>

<body>
    <!-- Hero Section -->
    <section class="hero">
        <div class="container">
            <h1 class="display-4">Contact Us</h1>
            <p class="lead">We're here to help and answer any question you might have. We look forward to hearing from you!</p>
            <a href="#" class="btn btn-warning-custom me-2">Shop Now</a>
            <a href="#" class="btn btn-outline-secondary">Explore</a>
        </div>
    </section>

    <!-- Contact Info + Form -->
    <section class="py-5">
        <div class="container">
            <div class="row text-center mb-5">
                <div class="col-md-4 contact-info">
                    <i class="fas fa-map-marker-alt"></i>
                    <p>43 Raymouth Rd, London 3910</p>
                </div>
                <div class="col-md-4 contact-info">
                    <i class="fas fa-envelope"></i>
                    <p>info@yourdomain.com</p>
                </div>
                <div class="col-md-4 contact-info">
                    <i class="fas fa-phone"></i>
                    <p>+1 294 3925 3939</p>
                </div>
            </div>

            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <form novalidate>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="text" id="fname" class="form-control" placeholder="First name">
                                    <label for="fname">First Name</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="text" id="lname" class="form-control" placeholder="Last name">
                                    <label for="lname">Last Name</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-floating">
                                    <input type="email" id="email" class="form-control" placeholder="name@example.com">
                                    <label for="email">Email address</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-floating">
                                    <textarea class="form-control" placeholder="Leave a message here" id="message" style="height: 150px;"></textarea>
                                    <label for="message">Message</label>
                                </div>
                            </div>
                            <div class="col-12 text-center">
                                <button type="submit" class="btn btn-warning-custom px-5">Send Message</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->

    <footer class="footer-section bg-light text-dark mt-5 pt-5 pb-3" role="contentinfo">
        <div class="container">
            <div class="row mb-5">
                <div class="col-md-6 mb-4 mb-md-0">
                    <h5 class="fw-bold mb-3">TechXpress<span class="text-primary">.</span></h5>
                    <p>Enhancing your home with comfort and design. Reach us for quality furniture and support.</p>
                    <div class="d-flex gap-3">
                        <a href="#" class="text-dark" aria-label="Facebook"><i class="fab fa-facebook-f fa-lg hover-opacity"></i></a>
                        <a href="#" class="text-dark" aria-label="Twitter"><i class="fab fa-twitter fa-lg hover-opacity"></i></a>
                        <a href="#" class="text-dark" aria-label="Instagram"><i class="fab fa-instagram fa-lg hover-opacity"></i></a>
                        <a href="#" class="text-dark" aria-label="LinkedIn"><i class="fab fa-linkedin-in fa-lg hover-opacity"></i></a>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="row">
                        <div class="col-6 col-md-4 mb-3">
                            <h6 class="fw-bold">Company</h6>
                            <ul class="list-unstyled">
                                <li><a href="#" class="text-decoration-none text-muted">About us</a></li>
                                <li><a href="#" class="text-decoration-none text-muted">Services</a></li>
                                <li><a href="#" class="text-decoration-none text-muted">Blog</a></li>
                                <li><a href="#" class="text-decoration-none text-muted">Contact</a></li>
                            </ul>
                        </div>
                        <div class="col-6 col-md-4 mb-3">
                            <h6 class="fw-bold">Support</h6>
                            <ul class="list-unstyled">
                                <li><a href="#" class="text-decoration-none text-muted">Help Center</a></li>
                                <li><a href="#" class="text-decoration-none text-muted">FAQs</a></li>
                                <li><a href="#" class="text-decoration-none text-muted">Live Chat</a></li>
                            </ul>
                        </div>
                        <div class="col-6 col-md-4 mb-3">
                            <h6 class="fw-bold">Products</h6>
                            <ul class="list-unstyled">
                                <li><a href="#" class="text-decoration-none text-muted">Nordic Chair</a></li>
                                <li><a href="#" class="text-decoration-none text-muted">Kruzo Aero</a></li>
                                <li><a href="#" class="text-decoration-none text-muted">Ergonomic Chair</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Newsletter Section -->
            <div class="row mb-4">
                <div class="col-md-8 mx-auto text-center">
                    <h6 class="fw-bold mb-3">Subscribe to our newsletter</h6>
                    <form class="d-flex justify-content-center">
                        <input type="email" class="form-control w-50 me-2" placeholder="Enter your email" aria-label="Email address">
                        <button type="submit" class="btn btn-primary">Subscribe</button>
                    </form>
                </div>
            </div>

            <div class="border-top pt-3 text-center small">
                <p class="mb-1">&copy; <script>document.write(new Date().getFullYear());</script> TechXpress. All rights reserved.</p>
                <p class="mb-0">
                    Designed by <a href="https://untree.co" target="_blank" rel="noopener">Untree.co</a>, Distributed by
                    <a href="https://themewagon.com" target="_blank" rel="noopener">ThemeWagon</a>
                </p>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
